{
  "redirects": [
    {
      "source": "/admin-login.html",
      "destination": "/admin.html",
      "permanent": true
    },
    {
      "source": "/api/private-console",
      "destination": "/admin.html",
      "permanent": false
    },
    {
      "source": "/api/login",
      "destination": "/admin.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/FMM_CLASSICO_CUSTOMER.html",
      "destination": "/"
    },
    {
      "source": "/product/:id",
      "destination": "/api/share?id=:id"
    },
    {
      "source": "/catalogue",
      "destination": "/api/share-catalogue"
    },
    {
      "source": "/:slug",
      "destination": "/api/share?slug=:slug"
    }
  ]
}
